# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY tsconfig.worker.json ./
COPY lib/orchestrator ./lib/orchestrator
COPY worker ./worker
RUN pnpm exec tsc -p tsconfig.worker.json

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache ca-certificates tini && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=builder --chown=worker:nodejs /app/dist-worker ./dist-worker
USER worker
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist-worker/worker/main.js"]
