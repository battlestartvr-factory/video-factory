# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY tsconfig.worker.json ./
COPY lib/orchestrator ./lib/orchestrator
COPY lib/models/kie ./lib/models/kie
COPY lib/game-discovery ./lib/game-discovery
COPY lib/research-intelligence ./lib/research-intelligence
COPY lib/web ./lib/web
COPY lib/agent/config.ts lib/agent/redaction.ts ./lib/agent/
COPY lib/knowledge/extraction.ts ./lib/knowledge/extraction.ts
COPY lib/logging/logger.ts ./lib/logging/logger.ts
COPY lib/asset-ingest/url-safety.ts lib/asset-ingest/types.ts ./lib/asset-ingest/
COPY worker ./worker
RUN pnpm exec tsc -p tsconfig.worker.json

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache ca-certificates tini ffmpeg && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=builder --chown=worker:nodejs /app/dist-worker ./dist-worker
USER worker
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist-worker/worker/main.js"]
