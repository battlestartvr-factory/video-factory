NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_FACTORY_BASE_URL=
FACTORY_WEBHOOK_SECRET=

APP_URL=http://localhost:3000
MOCK_WORKFLOWS=true

# Google Drive — knowledge originals (optional)
GOOGLE_DRIVE_INTEGRATION_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_DRIVE_SHARED_FOLDER_ID=

# service_account mode
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# oauth_user mode (pre-issued refresh token; no UI flow required yet)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

LOG_LEVEL=info

# Internal asset-ingest proxy (n8n WF32) — never commit real values
INGEST_PROXY_TOKEN=

# Backblaze B2 S3-compatible API (temp asset bucket)
B2_S3_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=battlestart-factory-temp

# KIE Model Registry (canonical provider for all AI models)
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai

# Deprecated LLM env — prefer KIE_API_KEY / registry defaults
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_DEFAULT_MODEL=
AGENT_LLM_ALLOWED_MODELS=

# Web research (optional). Provider: tavily | brave | generic | none
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
