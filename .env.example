NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional modern server-key fallback:
SUPABASE_SECRET_KEY=

APP_URL=http://localhost:3000
MOCK_WORKFLOWS=true
LOG_LEVEL=info

# KIE — canonical AI provider for agent/research/image/video
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
# Game Discovery v3 grounded-search model override; default is gemini-3-6-flash
KIE_WEB_SEARCH_MODEL=gemini-3-6-flash

# Game Discovery / generic web provider selector.
# Production Compose defaults to kie; alternatives remain legacy/optional.
WEB_SEARCH_PROVIDER=kie
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Durable worker tuning. Compose overrides queue mode/concurrency per worker.
# ORCHESTRATOR_WORKER_ID=
# ORCHESTRATOR_QUEUE_MODE=core
# WORKER_CONCURRENCY=1
# ORCHESTRATOR_QUEUE_POLL_MS=1000
# ORCHESTRATOR_LEASE_SECONDS=90
# ORCHESTRATOR_VISIBILITY_SECONDS=120
# ORCHESTRATOR_LEASE_HEARTBEAT_MS=1000
# ORCHESTRATOR_WORKER_HEARTBEAT_MS=15000
# ORCHESTRATOR_WATCHDOG_MS=60000
# ORCHESTRATOR_MAX_ATTEMPTS=5
# WORKER_APP_INTERNAL_URL=http://app:3000
# BUILD_SHA=

# Google Drive — local/dev may disable it; current production deploy requires owner OAuth.
GOOGLE_DRIVE_INTEGRATION_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=oauth_user
GOOGLE_DRIVE_SHARED_FOLDER_ID=

# Current production-style oauth_user mode
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Legacy/service_account mode for compatible non-production paths
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# Internal asset-ingest proxy — never commit real values
INGEST_PROXY_TOKEN=

# Backblaze B2 S3-compatible temp asset bucket
B2_S3_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=battlestart-factory-temp

# Legacy n8n / generic content lane. Not used by current Game Discovery v3 orchestration.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_FACTORY_BASE_URL=
FACTORY_WEBHOOK_SECRET=

# Deprecated LLM aliases — prefer KIE_API_KEY / registry/task policy
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_DEFAULT_MODEL=
AGENT_LLM_ALLOWED_MODELS=

# VPS/Compose optional overrides
# AI_FACTORY_ENV_FILE=/opt/ai-factory/.env
# AI_FACTORY_DATA_ROOT=/srv/ai-factory
