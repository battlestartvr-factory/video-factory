{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-worker",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "worker/**/*.ts",
    "lib/orchestrator/**/*.ts",
    "lib/models/kie/market-task.ts",
    "lib/game-discovery/schemas.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
