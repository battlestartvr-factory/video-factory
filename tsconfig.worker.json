{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-worker",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "worker/**/*.ts",
    "lib/orchestrator/**/*.ts",
    "lib/models/kie/market-task.ts",
    "lib/models/kie/claude-task.ts",
    "lib/game-discovery/schemas.ts",
    "lib/game-discovery/diversity.ts",
    "lib/game-discovery/concept-explorer.ts",
    "lib/game-discovery/worker-repository.ts",
    "lib/research-intelligence/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
