# Production env template for VPS: /opt/ai-factory/.env
# Never commit real values.

# --- Public/build-time Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase server ---
SUPABASE_SERVICE_ROLE_KEY=
# Optional alternate modern server secret:
# SUPABASE_SECRET_KEY=

# --- App ---
APP_URL=https://battlestart-factory.duckdns.org
MOCK_WORKFLOWS=false
LOG_LEVEL=info

# --- KIE / current Game Discovery v3 ---
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_WEB_SEARCH_MODEL=gemini-3-6-flash
# Compose defaults this to kie; keep explicit for operational clarity.
WEB_SEARCH_PROVIDER=kie

# --- Google Drive durable archive: REQUIRED by current production deploy ---
GOOGLE_DRIVE_INTEGRATION_ENABLED=true
GOOGLE_DRIVE_AUTH_MODE=oauth_user
GOOGLE_DRIVE_SHARED_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Legacy/service-account compatibility only; current production Compose forces oauth_user.
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=

# --- Backblaze B2 temp asset ingest ---
INGEST_PROXY_TOKEN=
B2_S3_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=battlestart-factory-temp

# --- Durable worker tuning (optional) ---
# Compose sets ORCHESTRATOR_QUEUE_MODE and WORKER_CONCURRENCY separately for core/research workers.
# ORCHESTRATOR_QUEUE_POLL_MS=1000
# ORCHESTRATOR_LEASE_SECONDS=90
# ORCHESTRATOR_VISIBILITY_SECONDS=120
# ORCHESTRATOR_LEASE_HEARTBEAT_MS=1000
# ORCHESTRATOR_WORKER_HEARTBEAT_MS=15000
# ORCHESTRATOR_WATCHDOG_MS=60000
# ORCHESTRATOR_MAX_ATTEMPTS=5

# --- Optional alternative/legacy web-search provider fields ---
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# --- Legacy n8n / generic content lane ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_FACTORY_BASE_URL=
FACTORY_WEBHOOK_SECRET=

# --- Deprecated LLM aliases ---
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_DEFAULT_MODEL=
# AGENT_LLM_ALLOWED_MODELS=

# --- Docker/runtime paths (optional overrides) ---
# AI_FACTORY_ENV_FILE=/opt/ai-factory/.env
# AI_FACTORY_DATA_ROOT=/srv/ai-factory
