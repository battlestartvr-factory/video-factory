# Production env template for VPS (/opt/ai-factory/.env)
#
# Copy to the VPS (never commit real values):
#   sudo install -d -m 750 /opt/ai-factory
#   sudo cp deploy/env.production.example /opt/ai-factory/.env
#   sudo chmod 640 /opt/ai-factory/.env
#   sudo chown root:deploy /opt/ai-factory/.env

# --- Public (also required at Docker build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase server ---
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- App ---
APP_URL=http://YOUR_VPS_IP
MOCK_WORKFLOWS=false
LOG_LEVEL=info

# --- KIE / agent ---
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai

# --- Google Drive (knowledge originals) ---
GOOGLE_DRIVE_INTEGRATION_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_DRIVE_SHARED_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# oauth_user mode:
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# --- n8n / factory (still external) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_FACTORY_BASE_URL=
FACTORY_WEBHOOK_SECRET=

# --- Asset ingest → Backblaze B2 (R2-compatible temp bucket) ---
INGEST_PROXY_TOKEN=
B2_S3_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=battlestart-factory-temp

# --- Web research (optional) ---
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# --- Deprecated LLM aliases (optional fallback) ---
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_DEFAULT_MODEL=

# --- Docker runtime paths (optional overrides) ---
# AI_FACTORY_ENV_FILE=/opt/ai-factory/.env
# AI_FACTORY_DATA_ROOT=/srv/ai-factory
